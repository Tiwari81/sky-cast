# SkyCast Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=skycast_super_secret_jwt_key_2026_prod

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=skycast_db

# SQLite Fallback (Set to True to force SQLite for quick local test)
USE_SQLITE=False
SQLITE_DB_PATH=skycast.db

# Optional External API Keys (Defaults to Open-Meteo free high-res APIs)
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
